/src/ladb_opencutlist/css/lib/*.min.css
# Compiled twig bundles. Generated by `gulp compile`, so normally ignored —
# EXCEPT the tabs bundle, which is tracked on the mcft branch on purpose.
#
# The Mac loads the extension straight out of a git clone; its only update
# step is `git pull` at SketchUp start. The other route in, dist/*.rbz, is
# not rebuildable here: that archive is the sole carrier of the Packy /
# Clippy / Imagy native engines, which are themselves gitignored, so a
# rebuild would ship a plugin whose cutting diagrams no longer load. Git is
# therefore the only way an MCFT twig change can reach SketchUp.
#
# Keeping a build output in git needs a guard, and CI has one: it runs the
# compile and fails if this file does not match the twig it came from.
/src/ladb_opencutlist/js/templates/*
!/src/ladb_opencutlist/js/templates/tabs-twig-templates.js
/src/ladb_opencutlist/js/i18n/
/src/ladb_opencutlist/js/lib/three-orbit-controls.js
/src/ladb_opencutlist/js/lib/three-css-2d-renderer.js
/src/ladb_opencutlist/js/lib/three.js
/src/ladb_opencutlist/js/lib/bootstrap-slider.js
/src/ladb_opencutlist/bin/osx/lib/*
/src/ladb_opencutlist/bin/win/lib/*
/src/ladb_opencutlist/yaml/i18n/*
/docs/skp/*~.skp
/build/node_modules/
/build/cmake-build/
/build/package-lock.json
/Gemfile.lock
/cmake-*
