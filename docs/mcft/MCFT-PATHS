# THE MCFT PATHS — every path in this tree that is NOT OpenCutList's.
#
# Read by tools/mcft-take-upstream.sh (which takes every OTHER path from the
# upstream build named in docs/mcft/UPSTREAM) and by tools/check-upstream-tree.rb
# (which proves on every push that every other path IS that build's, byte for
# byte). Design: docs/mcft/MOP-ON-OCL8.md §1.2, §2.2, §7.3 check 6.
#
# own:      paths MCFT ADDS. Each exists at HEAD and not at the build. A line
#           ending in / is a directory: every file under it is MCFT's.
# changed:  upstream files MCFT EDITS. Each exists at HEAD and at the build.
#           They are three-way merged on every upstream move, never taken.
#
# EVERY COMMIT THAT ADDS OR REMOVES AN MCFT PATH EDITS THIS FILE IN THE SAME
# COMMIT. Check 6 fails otherwise.

own:
.githooks/
.github/workflows/mcft-checks.yml
build/package-lock.json
docs/mcft/
node_modules/
